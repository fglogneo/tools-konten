<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Kecil 46 | Islamic Creator Pro Dashboard</title>
    
    <!-- Fonts: Fira Code (Cyber/Tech) & Amiri (Arabic/Islamic) -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Fira+Code:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome (Icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Particles.js & Marked.js -->
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Tailwind Config & Custom CSS -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        vrdark: '#030307',
                        vryellow: '#E9FF00',
                        vrmagenta: '#ff0055'
                    },
                    fontFamily: {
                        cyber: ['"Fira Code"', 'monospace'],
                        arab: ['"Amiri"', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #030307; color: #ffffff; font-family: 'Fira Code', monospace; overflow-x: hidden; }
        
        /* Neon Effects VR46 Theme */
        .neon-text-yellow { text-shadow: 0 0 5px #E9FF00, 0 0 15px #E9FF00, 0 0 30px #E9FF00; }
        .neon-text-magenta { text-shadow: 0 0 5px #ff0055, 0 0 15px #ff0055, 0 0 30px #ff0055; }
        .neon-border-yellow { box-shadow: 0 0 10px #E9FF00, inset 0 0 5px #E9FF00; border: 1px solid #E9FF00; }
        .neon-border-magenta { box-shadow: 0 0 10px #ff0055, inset 0 0 5px #ff0055; border: 1px solid #ff0055; }
        .glass-panel { background: rgba(3, 3, 7, 0.7); backdrop-filter: blur(10px); }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #030307; }
        ::-webkit-scrollbar-thumb { background: #ff0055; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #E9FF00; }

        /* Utilities */
        #particles-js { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
        .hidden { display: none !important; }
        
        /* Visualizer Canvas */
        #visualizer-canvas { width: 100%; max-width: 400px; height: auto; aspect-ratio: 9/16; background: #000; border-radius: 10px; margin: 0 auto; display: block; }
        
        /* Islamic Pattern Overlay */
        .islamic-pattern {
            background-image: url('data:image/svg+xml;utf8,<svg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M20 0l20 20-20 20L0 20z" fill="none" stroke="rgba(233,255,0,0.05)" stroke-width="1"/></svg>');
            position: absolute; inset: 0; z-index: -1; opacity: 0.5;
        }

        /* Toast Animation */
        @keyframes slideUp { from { bottom: -50px; opacity: 0; } to { bottom: 20px; opacity: 1; } }
        .toast { animation: slideUp 0.3s forwards; }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col relative">

    <div id="particles-js"></div>
    <div class="islamic-pattern pointer-events-none"></div>

    <!-- Navigation -->
    <nav class="glass-panel border-b border-vrmagenta/50 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex-shrink-0 cursor-pointer" onclick="app.goHome()">
                    <span class="text-2xl font-bold neon-text-yellow italic">STDK<span class="text-vrmagenta neon-text-magenta">46</span></span>
                    <span class="ml-2 text-xs text-gray-400 hidden md:inline block font-arab">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيم</span>
                </div>
                <!-- Stats & Actions -->
                <div class="flex items-center space-x-4">
                    <div class="hidden sm:block text-xs">
                        <span class="text-vryellow"><i class="fas fa-eye"></i> Online: <span id="visitor-count">104</span></span>
                    </div>
                    <button onclick="app.toggleModal('key-modal')" class="text-white hover:text-vryellow transition px-3 py-2 rounded-md text-sm neon-border-yellow glass-panel">
                        <i class="fas fa-key"></i> Multi-API
                    </button>
                    <button onclick="app.toggleModal('donation-modal')" class="bg-vrmagenta hover:bg-pink-700 text-white px-4 py-2 rounded-md text-sm font-bold neon-border-magenta transition">
                        <i class="fas fa-donate"></i> Infak
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full z-10">
        
        <!-- Dashboard Grid View -->
        <div id="dashboard-view">
            <div class="text-center mb-10">
                <h1 class="text-4xl font-bold mb-2">Pusat Kendali <span class="neon-text-yellow">Kreator Islami</span></h1>
                <p class="text-gray-400 text-sm">High-CTR Tools Dashboard • Coded by Studio Kecil 46 AI</p>
            </div>
            <div id="modules-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Dynamic Modules injected here -->
            </div>
        </div>

        <!-- Single Module View -->
        <div id="module-view" class="hidden">
            <button onclick="app.goHome()" class="mb-6 text-vryellow hover:text-white transition">
                <i class="fas fa-arrow-left mr-2"></i>Kembali ke Pusat Kendali
            </button>
            <div id="module-content" class="glass-panel p-6 rounded-lg neon-border-yellow">
                <!-- Dynamic Content injected here -->
            </div>
        </div>

    </main>

    <!-- Footer with Ticker -->
    <footer class="glass-panel border-t border-vryellow/50 mt-auto z-10">
        <div class="overflow-hidden whitespace-nowrap py-2 flex items-center border-b border-gray-800">
            <span class="text-xs text-vryellow font-bold px-4">🔴 LIVE INFAK:</span>
            <div class="inline-block animate-[marquee_15s_linear_infinite]" style="animation: marquee 20s linear infinite;">
                <span id="donor-ticker" class="text-xs text-gray-300">Hamba Allah (Rp 50.000) • Ahmad (Rp 100.000) • Ukhti F (Rp 25.000) • Budi (Rp 500.000)</span>
            </div>
        </div>
        <div class="text-center py-4 text-xs text-gray-500">
            &copy; 2026 Studio Kecil 46 Architecture AI. All systems online. Alhamdulillah.
        </div>
    </footer>

    <!-- CSS Keyframe for Marquee injected here to ensure it works without complex tailwind config -->
    <style> @keyframes marquee { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } } </style>

    <!-- Modals -->
    <!-- API Key Manager Modal -->
    <div id="key-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="glass-panel w-full max-w-lg p-6 rounded-lg neon-border-yellow relative">
            <button onclick="app.toggleModal('key-modal')" class="absolute top-4 right-4 text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
            <h2 class="text-2xl font-bold mb-4 neon-text-yellow"><i class="fas fa-server"></i> Multi-API Key Manager</h2>
            <p class="text-xs text-gray-300 mb-4">Masukkan API Key Google Gemini (AI Studio). Anda bisa memasukkan lebih dari satu key (satu per baris) untuk mem-bypass limit (Round-Robin system).</p>
            <textarea id="api-keys-input" rows="5" class="w-full bg-vrdark border border-vrmagenta rounded p-3 text-sm focus:outline-none focus:border-vryellow mb-4" placeholder="AIzaSy...&#10;AIzaSy..."></textarea>
            <button onclick="app.saveApiKeys()" class="w-full bg-vryellow text-black font-bold py-2 rounded hover:bg-yellow-400 transition">Simpan Konfigurasi</button>
        </div>
    </div>

    <!-- Donation Modal -->
    <div id="donation-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="glass-panel w-full max-w-md p-6 rounded-lg neon-border-magenta text-center relative">
            <button onclick="app.toggleModal('donation-modal')" class="absolute top-4 right-4 text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
            <h2 class="text-2xl font-bold mb-2 neon-text-magenta">Dukung Proyek Ini</h2>
            <p class="text-xs text-gray-300 mb-6">Infaq terbaik untuk pengembangan dakwah digital Studio Kecil 46. Scan QRIS di bawah ini:</p>
            <div class="bg-white p-4 rounded-lg inline-block mb-6 shadow-[0_0_20px_#ff0055]">
                <!-- Placeholder for real QR, using a generated dummy QR via UI-Avatars for structure -->
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://saweria.co/studiokecil46" alt="QRIS Saweria" class="w-48 h-48 mx-auto">
            </div>
            <p class="text-sm font-bold text-vryellow">Jazakumullahu Khairan Katsiran</p>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col space-y-2"></div>

    <!-- Application Logic -->
    <script>
        const app = {
            state: {
                apiKeys: [],
                currentKeyIndex: 0,
                activeModule: null,
                plannerData: JSON.parse(localStorage.getItem('stdk46_planner')) || [],
                audioContext: null,
                audioSource: null,
                analyzer: null,
                animationId: null
            },
            
            // --- Core Config & Modules ---
            modules: [
                { id: 'ai-story', title: 'AI Story Teller', icon: 'fa-book-open', desc: 'Buat cerita inspiratif Islami', type: 'ai', prompt: 'Anda adalah penulis cerita Islami profesional. Buat cerita inspiratif, menyentuh hati, dengan nilai dakwah. Gunakan gaya bahasa copywriting High-CTR. Buat paragraf pendek. Berikan hook di awal.' },
                { id: 'ai-script', title: 'AI Script Video', icon: 'fa-video', desc: 'Naskah video dakwah High-CTR', type: 'ai', prompt: 'Buat naskah video pendek (Tiktok/Reels/Shorts) Islami. Struktur: 1. Hook (3 detik pertama harus bikin penasaran), 2. Isi materi (padat, bahasa kekinian tapi sopan), 3. Call to Action (ajakan kebaikan). Format naskah dengan timecode.' },
                { id: 'planner', title: 'Content Planner', icon: 'fa-calendar-alt', desc: 'Jadwal & Ide Konten', type: 'custom', render: 'renderPlanner' },
                { id: 'ai-hook', title: 'AI Hook Generator', icon: 'fa-magnet', desc: 'Kalimat pembuka anti-skip', type: 'ai', prompt: 'Berikan 5 alternatif kalimat pembuka (Hook) untuk video edukasi Islami berdasarkan topik yang diberikan user. Hook harus membuat orang berhenti scroll (Scroll stopper), memancing emosi (penasaran/kaget/relate), dan tetap syar\'i.' },
                { id: 'trending', title: 'Trending Analyzer', icon: 'fa-fire', desc: 'Riset topik hangat realtime', type: 'custom', render: 'renderTrending' },
                { id: 'ai-image', title: 'Image Prompt AI', icon: 'fa-image', desc: 'Prompt gambar Midjourney/Bing', type: 'ai', prompt: 'Buatkan prompt bahasa Inggris untuk AI Image Generator (Midjourney/DALL-E) berdasarkan ide user. Tema: Cinematic, hiper-realistis, bernuansa agamis/islami estetik. Format: [Subjek utama], [Latar belakang], [Pencahayaan], [Gaya kamera/render].' },
                { id: 'ai-video', title: 'Video Prompt AI', icon: 'fa-film', desc: 'Prompt untuk Sora/Runway', type: 'ai', prompt: 'Buatkan prompt text-to-video bahasa Inggris untuk AI (Runway/Sora). Deskripsikan gerakan (motion), sudut kamera, pencahayaan, dan suasana secara detail. Topik tentang nilai Islami atau edukasi.' },
                { id: 'visualizer', title: 'Music Visualizer', icon: 'fa-music', desc: 'Buat video spektrum audio', type: 'custom', render: 'renderVisualizer' },
                { id: 'downloader', title: 'Media Downloader', icon: 'fa-download', desc: 'Download tanpa watermark', type: 'custom', render: 'renderDownloader' },
                { id: 'quran', title: 'Al-Qur\'an Pro', icon: 'fa-quran', desc: 'Teks, Terjemahan & Murottal', type: 'custom', render: 'renderQuran' },
                { id: 'quotes', title: 'Islamic Quotes', icon: 'fa-quote-left', desc: 'Hadits & Mutiara Hikmah', type: 'custom', render: 'renderQuotes' },
                { id: 'audio-finder', title: 'Nasheed Finder', icon: 'fa-search', desc: 'Cari audio & backsound halal', type: 'custom', render: 'renderAudioFinder' },
                { id: 'qibla', title: 'Prayer & Qibla', icon: 'fa-compass', desc: 'Jadwal Sholat Otomatis', type: 'custom', render: 'renderPrayerTimes' }
            ],

            init() {
                this.loadApiKeys();
                this.renderDashboard();
                this.initParticles();
                this.startLiveSimulations();
                
                // Show initial greeting toast
                setTimeout(() => this.showToast("Sistem online. Ahlan wa sahlan, Kreator!", 'success'), 1000);
            },

            // --- Utilities ---
            showToast(message, type = 'info') {
                const colors = type === 'success' ? 'bg-vryellow text-black' : (type === 'error' ? 'bg-vrmagenta text-white' : 'bg-gray-800 text-white border border-vryellow');
                const toast = document.createElement('div');
                toast.className = `toast px-4 py-2 rounded-md shadow-lg ${colors} font-bold text-sm z-50`;
                toast.innerHTML = message;
                document.getElementById('toast-container').appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            },

            toggleModal(id) {
                const modal = document.getElementById(id);
                if (modal.classList.contains('hidden')) {
                    modal.classList.remove('hidden');
                    if (id === 'key-modal') {
                        document.getElementById('api-keys-input').value = this.state.apiKeys.join('\n');
                    }
                } else {
                    modal.classList.add('hidden');
                }
            },

            fallbackCopyText(text) {
                const textArea = document.createElement("textarea");
                textArea.value = text;
                textArea.style.position = "fixed";
                textArea.style.left = "-9999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    this.showToast('Teks berhasil disalin!', 'success');
                } catch (err) {
                    this.showToast('Gagal menyalin teks.', 'error');
                }
                document.body.removeChild(textArea);
            },

            downloadBlob(text, filename) {
                const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                this.showToast('File diunduh.', 'success');
            },

            // --- Key Management ---
            loadApiKeys() {
                const keys = localStorage.getItem('stdk46_gemini_keys');
                if (keys) {
                    this.state.apiKeys = JSON.parse(keys);
                }
            },

            saveApiKeys() {
                const raw = document.getElementById('api-keys-input').value;
                const keys = raw.split('\n').map(k => k.trim()).filter(k => k.length > 10);
                this.state.apiKeys = keys;
                localStorage.setItem('stdk46_gemini_keys', JSON.stringify(keys));
                this.toggleModal('key-modal');
                this.showToast(`${keys.length} API Key tersimpan!`, 'success');
            },

            getGeminiKey() {
                if (this.state.apiKeys.length === 0) return null;
                const key = this.state.apiKeys[this.state.currentKeyIndex];
                // Round Robin
                this.state.currentKeyIndex = (this.state.currentKeyIndex + 1) % this.state.apiKeys.length;
                return key;
            },

            // --- Navigation ---
            goHome() {
                document.getElementById('module-view').classList.add('hidden');
                document.getElementById('dashboard-view').classList.remove('hidden');
                this.state.activeModule = null;
                // Stop audio visualizer if running
                if (this.state.audioContext) {
                    this.state.audioContext.close();
                    this.state.audioContext = null;
                    cancelAnimationFrame(this.state.animationId);
                }
            },

            openModule(id) {
                const mod = this.modules.find(m => m.id === id);
                if (!mod) return;
                
                this.state.activeModule = mod;
                document.getElementById('dashboard-view').classList.add('hidden');
                document.getElementById('module-view').classList.remove('hidden');
                
                const container = document.getElementById('module-content');
                container.innerHTML = `<h2 class="text-2xl font-bold mb-4 border-b border-gray-700 pb-2"><i class="fas ${mod.icon} text-vryellow mr-2"></i>${mod.title}</h2><div id="module-body">Memuat antarmuka...</div>`;
                
                const body = document.getElementById('module-body');

                if (mod.type === 'ai') {
                    this.renderAIToolTemplate(mod, body);
                } else if (mod.type === 'custom') {
                    this[mod.render](body);
                }
            },

            renderDashboard() {
                const grid = document.getElementById('modules-grid');
                grid.innerHTML = '';
                this.modules.forEach(mod => {
                    grid.innerHTML += `
                        <div onclick="app.openModule('${mod.id}')" class="glass-panel p-6 rounded-lg cursor-pointer border border-gray-800 hover:border-vryellow transition transform hover:-translate-y-1 group relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-transparent to-vrmagenta/10 opacity-0 group-hover:opacity-100 transition"></div>
                            <i class="fas ${mod.icon} text-4xl mb-4 text-gray-400 group-hover:text-vryellow transition neon-text-yellow"></i>
                            <h3 class="text-lg font-bold mb-2">${mod.title}</h3>
                            <p class="text-sm text-gray-500">${mod.desc}</p>
                        </div>
                    `;
                });
            },

            // --- AI Tool Template (Gemini) ---
            renderAIToolTemplate(mod, container) {
                if (this.state.apiKeys.length === 0) {
                    container.innerHTML = `
                        <div class="bg-red-900/50 p-4 rounded border border-red-500 text-center">
                            <p class="mb-4">Sistem mendeteksi Anda belum memasukkan API Key Gemini.</p>
                            <button onclick="app.toggleModal('key-modal')" class="bg-vryellow text-black px-4 py-2 rounded font-bold"><i class="fas fa-key"></i> Masukkan API Key Sekarang</button>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="flex flex-col space-y-4">
                        <textarea id="ai-input" rows="4" class="w-full bg-vrdark border border-gray-700 rounded p-4 text-white focus:outline-none focus:border-vryellow transition" placeholder="Masukkan ide atau topik Anda di sini..."></textarea>
                        <button onclick="app.generateAI('${mod.id}')" id="ai-btn" class="bg-vryellow text-black font-bold py-3 rounded hover:bg-yellow-400 transition flex items-center justify-center">
                            <i class="fas fa-magic mr-2"></i> Generate (Bypass Limit)
                        </button>
                        <div id="ai-loader" class="hidden text-center text-vrmagenta animate-pulse font-bold py-4"><i class="fas fa-circle-notch fa-spin mr-2"></i> AI sedang memproses naskah langit...</div>
                        <div id="ai-output-container" class="hidden mt-4">
                            <div class="flex justify-end space-x-2 mb-2">
                                <button onclick="app.fallbackCopyText(document.getElementById('ai-raw-text').value)" class="text-xs bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded"><i class="fas fa-copy"></i> Salin</button>
                                <button onclick="app.downloadBlob(document.getElementById('ai-raw-text').value, '${mod.id}-result.txt')" class="text-xs bg-gray-800 hover:bg-gray-700 px-3 py-1 rounded"><i class="fas fa-download"></i> Download .txt</button>
                            </div>
                            <textarea id="ai-raw-text" class="hidden"></textarea>
                            <div id="ai-output" class="bg-black/80 p-6 rounded border border-vrmagenta/50 prose prose-invert max-w-none text-sm leading-relaxed"></div>
                        </div>
                    </div>
                `;
            },

            async generateAI(modId) {
                const input = document.getElementById('ai-input').value;
                if (!input.trim()) return this.showToast('Input tidak boleh kosong!', 'error');

                const mod = this.modules.find(m => m.id === modId);
                const apiKey = this.getGeminiKey();
                
                document.getElementById('ai-btn').classList.add('hidden');
                document.getElementById('ai-loader').classList.remove('hidden');
                document.getElementById('ai-output-container').classList.add('hidden');

                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ parts: [{ text: `${mod.prompt}\n\nTopik/Ide dari User: ${input}` }] }]
                        })
                    });

                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    
                    const data = await response.json();
                    const text = data.candidates[0].content.parts[0].text;
                    
                    document.getElementById('ai-raw-text').value = text;
                    document.getElementById('ai-output').innerHTML = marked.parse(text); // Using marked.js to render Markdown
                    document.getElementById('ai-output-container').classList.remove('hidden');
                } catch (error) {
                    this.showToast('Gagal terhubung ke AI. Cek API Key/Kuota.', 'error');
                    console.error(error);
                } finally {
                    document.getElementById('ai-btn').classList.remove('hidden');
                    document.getElementById('ai-loader').classList.add('hidden');
                }
            },

            // --- Custom Modules Renderers ---

            // 1. Content Planner
            renderPlanner(container) {
                container.innerHTML = `
                    <div class="flex space-x-2 mb-4">
                        <input type="date" id="plan-date" class="bg-vrdark border border-gray-700 rounded p-2 text-white">
                        <input type="text" id="plan-title" placeholder="Ide Konten..." class="flex-grow bg-vrdark border border-gray-700 rounded p-2 text-white">
                        <button onclick="app.addPlan()" class="bg-vrmagenta text-white px-4 rounded font-bold hover:bg-pink-600"><i class="fas fa-plus"></i></button>
                    </div>
                    <div class="flex justify-end mb-4">
                        <button onclick="app.exportPlanner()" class="text-xs border border-vryellow text-vryellow px-3 py-1 rounded hover:bg-vryellow hover:text-black transition">Export CSV</button>
                    </div>
                    <ul id="plan-list" class="space-y-2"></ul>
                `;
                this.updatePlannerUI();
            },
            addPlan() {
                const date = document.getElementById('plan-date').value;
                const title = document.getElementById('plan-title').value;
                if(!date || !title) return this.showToast('Isi tanggal dan ide!', 'error');
                this.state.plannerData.push({ id: Date.now(), date, title });
                localStorage.setItem('stdk46_planner', JSON.stringify(this.state.plannerData));
                this.updatePlannerUI();
                document.getElementById('plan-title').value = '';
            },
            deletePlan(id) {
                this.state.plannerData = this.state.plannerData.filter(p => p.id !== id);
                localStorage.setItem('stdk46_planner', JSON.stringify(this.state.plannerData));
                this.updatePlannerUI();
            },
            updatePlannerUI() {
                const list = document.getElementById('plan-list');
                if(!list) return;
                list.innerHTML = '';
                this.state.plannerData.sort((a,b) => new Date(a.date) - new Date(b.date)).forEach(p => {
                    list.innerHTML += `
                        <li class="flex justify-between bg-black/50 p-3 rounded border border-gray-800">
                            <span><span class="text-vryellow font-bold mr-3">[${p.date}]</span> ${p.title}</span>
                            <button onclick="app.deletePlan(${p.id})" class="text-red-500 hover:text-red-300"><i class="fas fa-trash"></i></button>
                        </li>`;
                });
            },
            exportPlanner() {
                const csv = "Tanggal,Ide Konten\n" + this.state.plannerData.map(p => `${p.date},"${p.title}"`).join('\n');
                this.downloadBlob(csv, 'content_plan.csv');
            },

            // 2. Trending Analyzer (RSS via CORS Proxy)
            async renderTrending(container) {
                container.innerHTML = `<div class="text-center text-vryellow py-10"><i class="fas fa-satellite-dish fa-spin text-3xl mb-4"></i><p>Mencegat sinyal tren global...</p></div>`;
                try {
                    // Google Trends RSS via allorigins proxy
                    const url = encodeURIComponent('https://trends.google.com/trends/trendingsearches/daily/rss?geo=ID');
                    const response = await fetch(`https://api.allorigins.win/get?url=${url}`);
                    const data = await response.json();
                    
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(data.contents, "text/xml");
                    const items = xmlDoc.querySelectorAll("item");
                    
                    let html = `<div class="grid gap-3">`;
                    items.forEach((item, index) => {
                        if(index > 9) return; // Top 10
                        const title = item.querySelector("title").textContent;
                        const traffic = item.getElementsByTagName("ht:approx_traffic")[0]?.textContent || '';
                        const link = item.querySelector("link").textContent;
                        html += `
                            <a href="${link}" target="_blank" class="block p-4 glass-panel border border-gray-800 hover:border-vrmagenta rounded transition group">
                                <div class="flex justify-between items-center">
                                    <span class="font-bold text-lg group-hover:text-vryellow transition"><span class="text-gray-600 mr-2">#${index+1}</span> ${title}</span>
                                    <span class="text-xs text-vrmagenta bg-vrmagenta/10 px-2 py-1 rounded">${traffic} penelusuran</span>
                                </div>
                            </a>`;
                    });
                    html += `</div>`;
                    container.innerHTML = html;
                } catch (err) {
                    container.innerHTML = `<div class="text-red-500">Gagal mengambil data tren. Proxy mungkin diblokir.</div>`;
                }
            },

            // 3. Al-Qur'an Pro (equran.id API)
            async renderQuran(container) {
                container.innerHTML = `<div class="text-center text-vryellow py-10"><i class="fas fa-spinner fa-spin text-3xl mb-4"></i><p>Memuat Mushaf...</p></div>`;
                try {
                    const res = await fetch('https://equran.id/api/v2/surat');
                    const data = await res.json();
                    let html = `<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">`;
                    data.data.forEach(s => {
                        html += `
                            <button onclick="app.loadSurah(${s.nomor})" class="p-3 text-left glass-panel border border-gray-800 hover:border-vryellow rounded transition relative overflow-hidden group">
                                <div class="font-bold text-sm">${s.nomor}. ${s.namaLatin}</div>
                                <div class="text-xs text-gray-400">${s.arti} • ${s.jumlahAyat} Ayat</div>
                                <div class="absolute top-2 right-2 font-arab text-xl text-gray-600 group-hover:text-vryellow opacity-50">${s.nama}</div>
                            </button>
