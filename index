                    const json = await res.json();
                    const data = json.data;
                    
                    let html = `
                        <button onclick="app.renderQuran(document.getElementById('module-body'))" class="mb-4 text-xs bg-gray-800 px-3 py-1 rounded"><i class="fas fa-arrow-left"></i> Kembali ke Daftar Surah</button>
                        <div class="text-center mb-6 border-b border-gray-800 pb-4">
                            <h3 class="text-3xl font-arab text-vryellow mb-2">${data.nama}</h3>
                            <p class="font-bold">${data.namaLatin} (${data.arti})</p>
                            <audio controls class="w-full max-w-md mx-auto mt-4 h-8" src="${data.audioFull['05']}"></audio>
                            <p class="text-xs text-gray-500 mt-1">Murottal: Syeikh Mishary Rashid</p>
                        </div>
                        <div class="space-y-6">
                    `;
                    
                    data.ayat.forEach(a => {
                        html += `
                            <div class="p-4 bg-black/40 rounded border border-gray-800/50">
                                <div class="flex justify-between items-start mb-4">
                                    <span class="bg-vryellow text-black text-xs font-bold px-2 py-1 rounded-full h-6">${a.nomorAyat}</span>
                                    <p class="font-arab text-3xl leading-loose text-right" dir="rtl">${a.teksArab}</p>
                                </div>
                                <p class="text-vrmagenta/80 text-sm mb-1 italic">${a.teksLatin}</p>
                                <p class="text-sm text-gray-300">${a.teksIndonesia}</p>
                            </div>
                        `;
                    });
                    html += `</div>`;
                    container.innerHTML = html;
                } catch (e) {
                    container.innerHTML = `<div class="text-red-500">Gagal memuat ayat.</div>`;
                }
            },

            // 4. Islamic Quotes / Hadith
            async renderQuotes(container) {
                container.innerHTML = `
                    <div class="text-center">
                        <button onclick="app.fetchRandomQuote()" class="bg-vrmagenta text-white font-bold py-3 px-8 rounded-full shadow-[0_0_15px_#ff0055] hover:scale-105 transition transform mb-8">
                            <i class="fas fa-sync-alt mr-2"></i> Munculkan Hikmah Baru
                        </button>
                        <div id="quote-box" class="min-h-[200px] flex items-center justify-center p-8 glass-panel border border-vryellow rounded-lg relative">
                            <i class="fas fa-quote-left absolute top-4 left-4 text-4xl text-gray-700"></i>
                            <div id="quote-content" class="text-xl font-bold italic leading-relaxed z-10 text-white">
                                Klik tombol di atas untuk mendapatkan kutipan acak dari API.
                            </div>
                        </div>
                        <div class="mt-4 flex justify-center space-x-2">
                            <button onclick="app.fallbackCopyText(document.getElementById('quote-content').innerText)" class="text-xs bg-gray-800 px-4 py-2 rounded border border-gray-600"><i class="fas fa-copy"></i> Salin Teks</button>
                        </div>
                    </div>
                `;
            },
            async fetchRandomQuote() {
                const box = document.getElementById('quote-content');
                box.innerHTML = `<i class="fas fa-spinner fa-spin text-vryellow"></i>`;
                try {
                    // Using a public Hadith API (randomizing from Bukhari range)
                    const randomNum = Math.floor(Math.random() * 300) + 1;
                    const res = await fetch(`https://api.hadith.gading.dev/books/bukhari?range=${randomNum}-${randomNum}`);
                    const data = await res.json();
                    const hadith = data.data.hadiths[0];
                    
                    box.innerHTML = `
                        <p class="font-arab text-2xl mb-4 text-vryellow leading-loose" dir="rtl">${hadith.arab}</p>
                        <p class="text-sm text-gray-300">"${hadith.id}"</p>
                        <p class="mt-4 text-xs text-vrmagenta font-bold">- HR. Bukhari No. ${hadith.number}</p>
                    `;
                } catch (e) {
                    box.innerHTML = "Gagal mengambil data dari server. Silakan coba lagi.";
                }
            },

            // 5. Music Visualizer (Canvas & Web Audio API)
            renderVisualizer(container) {
                container.innerHTML = `
                    <div class="flex flex-col items-center">
                        <p class="text-sm text-gray-400 mb-4 text-center">Visualizer Audio untuk Background Dakwah (Rasio 9:16).<br>Upload file audio (mp3/wav) dari perangkat Anda.</p>
                        <input type="file" id="audio-upload" accept="audio/*" class="mb-4 block w-full max-w-sm text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-vryellow file:text-black hover:file:bg-yellow-400">
                        <div class="relative w-full max-w-[300px] mx-auto border-2 border-gray-800 rounded-xl overflow-hidden shadow-[0_0_20px_rgba(233,255,0,0.2)]">
                            <canvas id="visualizer-canvas" width="300" height="533"></canvas>
                            <audio id="audio-player" controls class="absolute bottom-0 w-full opacity-50 hover:opacity-100 transition"></audio>
                        </div>
                        <p class="text-xs text-red-500 mt-4">*Fitur ini memproses audio secara lokal di browser, tidak ada file yang diunggah ke server.</p>
                    </div>
                `;
                
                document.getElementById('audio-upload').addEventListener('change', function(e) {
                    const file = this.files[0];
                    if (file) {
                        const audio = document.getElementById('audio-player');
                        audio.src = URL.createObjectURL(file);
                        audio.load();
                        app.initVisualizer(audio);
                        audio.play();
                    }
                });
            },
            initVisualizer(audioElement) {
                if(this.state.audioContext) return; // Already init
                
                const canvas = document.getElementById('visualizer-canvas');
                const ctx = canvas.getContext('2d');
                
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                this.state.audioContext = audioCtx;
                
                const src = audioCtx.createMediaElementSource(audioElement);
                const analyzer = audioCtx.createAnalyser();
                this.state.analyzer = analyzer;
                
                src.connect(analyzer);
                analyzer.connect(audioCtx.destination);
                
                analyzer.fftSize = 256;
                const bufferLength = analyzer.frequencyBinCount;
                const dataArray = new Uint8Array(bufferLength);
                
                const WIDTH = canvas.width;
                const HEIGHT = canvas.height;
                const barWidth = (WIDTH / bufferLength) * 2.5;
                
                const draw = () => {
                    this.state.animationId = requestAnimationFrame(draw);
                    analyzer.getByteFrequencyData(dataArray);
                    
                    ctx.fillStyle = '#030307';
                    ctx.fillRect(0, 0, WIDTH, HEIGHT);
                    
                    // Draw neon circle in center responding to bass
                    const bass = dataArray[1];
                    ctx.beginPath();
                    ctx.arc(WIDTH/2, HEIGHT/2, bass/2, 0, 2 * Math.PI);
                    ctx.strokeStyle = '#E9FF00';
                    ctx.lineWidth = 2;
                    ctx.shadowBlur = 15;
                    ctx.shadowColor = '#E9FF00';
                    ctx.stroke();
                    ctx.shadowBlur = 0; // reset

                    let x = 0;
                    for(let i = 0; i < bufferLength; i++) {
                        const barHeight = dataArray[i];
                        // Gradient yellow to magenta
                        const gradient = ctx.createLinearGradient(0, HEIGHT, 0, HEIGHT - barHeight);
                        gradient.addColorStop(0, '#ff0055');
                        gradient.addColorStop(1, '#E9FF00');
                        
                        ctx.fillStyle = gradient;
                        ctx.fillRect(x, HEIGHT - barHeight, barWidth, barHeight);
                        x += barWidth + 1;
                    }
                };
                
                draw();
            },

            // 6. Media Downloader (Using TikWM API for TikTok No Watermark)
            renderDownloader(container) {
                container.innerHTML = `
                    <div class="max-w-xl mx-auto">
                        <p class="text-sm mb-4">Download Video TikTok tanpa Watermark. Berguna untuk mengarsipkan materi kajian. <span class="text-red-500 font-bold">Pastikan izin syar'i (hak cipta).</span></p>
                        <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">
                            <input type="text" id="dl-url" placeholder="Paste Link Video TikTok di sini..." class="flex-grow bg-vrdark border border-gray-700 rounded p-3 focus:border-vryellow focus:outline-none">
                            <button onclick="app.fetchDownload()" class="bg-vryellow text-black font-bold px-6 py-3 rounded"><i class="fas fa-search"></i> Proses</button>
                        </div>
                        <div id="dl-result" class="mt-6 hidden glass-panel p-4 rounded border border-vrmagenta text-center"></div>
                    </div>
                `;
            },
            async fetchDownload() {
                const url = document.getElementById('dl-url').value;
                const resultBox = document.getElementById('dl-result');
                if(!url) return this.showToast('Masukkan link URL!', 'error');
                
                resultBox.classList.remove('hidden');
                resultBox.innerHTML = '<i class="fas fa-circle-notch fa-spin text-vryellow text-2xl"></i> Memproses link...';
                
                try {
                    // TikWM is a public free API for this purpose
                    const res = await fetch(`https://www.tikwm.com/api/?url=${url}`);
                    const data = await res.json();
                    
                    if(data.code === 0) {
                        const videoUrl = data.data.play;
                        const cover = data.data.cover;
                        resultBox.innerHTML = `
                            <img src="${cover}" class="w-32 h-auto mx-auto rounded mb-4 border border-gray-700">
                            <p class="text-sm mb-4 truncate px-4">${data.data.title}</p>
                            <a href="${videoUrl}" target="_blank" class="inline-block bg-vrmagenta text-white font-bold py-2 px-6 rounded hover:bg-pink-700"><i class="fas fa-download"></i> Download Video (MP4)</a>
                        `;
                    } else {
                        resultBox.innerHTML = '<span class="text-red-500">Video tidak ditemukan atau link tidak valid.</span>';
                    }
                } catch(e) {
                    resultBox.innerHTML = '<span class="text-red-500">Terjadi kesalahan pada server Downloader API.</span>';
                }
            },

            // 7. Audio Finder (iTunes API - Free, CORS open)
            renderAudioFinder(container) {
                container.innerHTML = `
                    <div class="max-w-xl mx-auto">
                        <p class="text-sm mb-4">Cari referensi nasyid, murottal, atau backsound Islami halal (via iTunes API). Dapatkan metadata dan preview audionya.</p>
                        <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">
                            <input type="text" id="audio-query" placeholder="Cari nasyid, nama syeikh..." class="flex-grow bg-vrdark border border-gray-700 rounded p-3 focus:border-vryellow focus:outline-none">
                            <button onclick="app.searchAudio()" class="bg-vrmagenta text-white font-bold px-6 py-3 rounded"><i class="fas fa-search"></i> Cari</button>
                        </div>
                        <div id="audio-results" class="mt-6 space-y-3"></div>
                    </div>
                `;
            },
            async searchAudio() {
                const query = document.getElementById('audio-query').value;
                const resultBox = document.getElementById('audio-results');
                if(!query) return;
                
                resultBox.innerHTML = '<div class="text-center"><i class="fas fa-spinner fa-spin text-vryellow text-2xl"></i></div>';
                try {
                    const res = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(query)}&media=music&limit=10`);
                    const data = await res.json();
                    
                    if(data.results.length === 0) {
                        resultBox.innerHTML = '<div class="text-gray-500 text-center">Tidak ada hasil ditemukan.</div>';
                        return;
                    }

                    let html = '';
                    data.results.forEach(track => {
                        html += `
                            <div class="flex items-center p-3 glass-panel rounded border border-gray-800">
                                <img src="${track.artworkUrl60}" class="w-12 h-12 rounded mr-4">
                                <div class="flex-grow">
                                    <div class="font-bold text-sm text-vryellow">${track.trackName}</div>
                                    <div class="text-xs text-gray-400">${track.artistName}</div>
                                </div>
                                <audio controls src="${track.previewUrl}" class="w-1/3 h-8"></audio>
                            </div>
                        `;
                    });
                    resultBox.innerHTML = html;
                } catch(e) {
                    resultBox.innerHTML = '<span class="text-red-500">Error mengambil data API.</span>';
                }
            },

            // 8. Prayer Times (Aladhan API)
            async renderPrayerTimes(container) {
                container.innerHTML = `<div class="text-center text-vryellow py-10"><i class="fas fa-clock fa-spin text-3xl mb-4"></i><p>Menghitung koordinat langit...</p></div>`;
                try {
                    // Default to Tangerang, ID as per system context
                    const res = await fetch('https://api.aladhan.com/v1/timingsByCity?city=Tangerang&country=Indonesia&method=20');
                    const data = await res.json();
                    const timings = data.data.timings;
                    const meta = data.data.meta;
                    
                    container.innerHTML = `
                        <div class="text-center mb-6">
                            <h3 class="text-2xl font-bold">Jadwal Sholat</h3>
                            <p class="text-gray-400">${data.data.date.readable} • Tangerang, Indonesia</p>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-center">
                            ${['Fajr', 'Sunrise', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'].map(prayer => `
                                <div class="p-4 glass-panel border ${prayer === 'Maghrib' ? 'border-vrmagenta' : 'border-gray-800'} rounded shadow-lg">
                                    <div class="text-sm text-gray-400 mb-1">${prayer === 'Fajr'?'Subuh':prayer==='Sunrise'?'Terbit':prayer==='Dhuhr'?'Dzuhur':prayer==='Asr'?'Ashar':prayer==='Isha'?'Isya':prayer}</div>
                                    <div class="text-2xl font-bold font-cyber text-vryellow">${timings[prayer]}</div>
                                </div>
                            `).join('')}
                        </div>
                        <div class="mt-6 text-center text-xs text-gray-500">
                            Metode: Kemenag RI | Zona Waktu: ${meta.timezone}
                        </div>
                    `;
                } catch(e) {
                    container.innerHTML = `<div class="text-red-500">Gagal mengambil jadwal sholat dari API Aladhan.</div>`;
                }
            },

            // --- Visuals & Effects ---
            initParticles() {
                particlesJS('particles-js', {
                    particles: {
                        number: { value: 60, density: { enable: true, value_area: 800 } },
                        color: { value: ["#E9FF00", "#ff0055", "#ffffff"] },
                        shape: { type: "circle" },
                        opacity: { value: 0.5, random: true },
                        size: { value: 3, random: true },
                        line_linked: { enable: true, distance: 150, color: "#ffffff", opacity: 0.1, width: 1 },
                        move: { enable: true, speed: 1, direction: "none", random: true, out_mode: "out" }
                    },
                    interactivity: {
                        detect_on: "canvas",
                        events: {
                            onhover: { enable: true, mode: "grab" },
                            onclick: { enable: true, mode: "push" }
                        },
                        modes: { grab: { distance: 140, line_linked: { opacity: 0.5 } } }
                    },
                    retina_detect: true
                });
            },

            startLiveSimulations() {
                // Visitor Count Simulation (Because free reliable websocket APIs for this are dead)
                setInterval(() => {
                    const countEl = document.getElementById('visitor-count');
                    let current = parseInt(countEl.innerText);
                    // Randomly add or subtract 1-3
                    let diff = Math.floor(Math.random() * 5) - 2; 
                    current += diff;
                    if(current < 46) current = 46;
                    countEl.innerText = current;
                }, 5000);
            }
        };

        // Initialize App on Load
        document.addEventListener('DOMContentLoaded', () => app.init());
    </script>
